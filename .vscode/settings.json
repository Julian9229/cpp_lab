{
  "clangd.path": "clangd",
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--header-insertion=iwyu"
  ],
  "clangd.fallbackFlags": ["-std=c++17", "-xc++", "-I."],
  "files.associations": {
    "*.h": "cpp",
    "*.hpp": "cpp"
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": false
  }
}
